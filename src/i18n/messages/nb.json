  "heritage": {
    "eyebrow": "Mellom to fjell: Kaukasus-høylandet",
    "p1": "Tårnene ved porten er bjov: vainakhiske kamptårn som tsjetsjenske og ingusjiske klaner bygde i Kaukasus fra 1000- til 1700-tallet.",
    "p2": "Byggerne stablet hugget stein uten mørtel. De gjorde foten tung, smalnet tårnet oppover og kronet taket med en spiss tsurko.",
    "p3": "Jeg bruker tårnene som bro: røtter i Kaukasus, liv i Norge og to fjellkulturer som respekterer utholdenhet og håndverk.",
    "facts": [
      {
        "k": "Bjov",
        "v": "Kamptårn. 20-25 m, fire-fem etasjer, kvadratisk grunnplan."
      },
      {
        "k": "Tsurko",
        "v": "Spiss toppstein på det trappede pyramidetaket."
      },
      {
        "k": "Cherh",
        "v": "Steinoverheng. Forsvarere brukte dem for å beskytte tårnet ovenfra."
      },
      {
        "k": "Kurtulg",
        "v": "Stolt stein. Sluttstein over dør og vindu; eieren kunne hugge navnet sitt i den."
      },
      {
        "k": "Ghala",
        "v": "Boligtårn. Familier levde rundt ildstedet og sentralpilaren Aerd-Bogham."
      }
    ],
    "kicker": "Mellom to fjell",
    "title": "Bjov: kamptårnet som måleobjekt",
